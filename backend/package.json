{
  "name": "playime-backend",
  "version": "1.0.0",
  "description": "Playime backend — Node.js + TypeScript + Fastify",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "smoke:opencode": "tsx scripts/smoke-opencode.ts",
    "smoke:chat": "tsx scripts/smoke-chat.ts",
    "smoke:stream": "tsx scripts/smoke-stream.ts",
    "smoke:longchat": "tsx scripts/smoke-longchat.ts",
    "db:check": "tsx scripts/db-check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
